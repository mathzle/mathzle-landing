---
import { t, type Locale } from '../utils/i18n';
import LangSwitch from './LangSwitch.astro';
import MobileDrawer from './MobileDrawer.astro';
import { site } from '../data/site';
import { resolveClaim } from '../data/claims';
import { Image } from 'astro:assets';
// 36px mark from a 584px / 410 KB PNG source: let astro:assets emit 1×/2×/3×
// WebP (~2–8 KB) — the raw PNG competed with the LCP on slow mobile links.
import logo from '../assets/brand/logo.png';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const i = t(locale);
const home = `/${locale}/`;
const links = [
  { href: `${home}#method`, label: i.nav.method },
  { href: `${home}#worlds`, label: i.nav.worlds },
  ...(resolveClaim('skillReport').show ? [{ href: `${home}#parents`, label: i.nav.parents }] : []),
  ...(site.pricing.public ? [{ href: `${home}#pricing`, label: i.nav.pricing }] : []),
  { href: `${home}faq/`, label: i.nav.faq },
];
---
<header class="nav-shell">
  <nav class="nav" aria-label="Primary">
    <a href={home} class="nav-logo" aria-label="Mathzle home">
      <Image
        src={logo}
        alt=""
        width={36}
        height={36}
        densities={[1, 2, 3]}
        format="webp"
        class="nav-logo-mark"
        loading="eager"
        decoding="async"
      />
      <span class="nav-logo-text">Mathzle</span>
    </a>
    <ul class="nav-links">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    <div class="nav-actions">
      <LangSwitch locale={locale} path={path} class="nav-lang" />
      <a
        href={site.appUrl}
        class="btn-push nav-cta"
        data-track="nav-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        {i.actions.primaryShort}
      </a>
      <button
        type="button"
        class="nav-menu-btn"
        data-open-nav
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label={i.nav.menu}
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </nav>
</header>

<MobileDrawer locale={locale} path={path} links={links} />

<style>
  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-mk-canvas) 92%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--color-mk-hairline);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .nav-logo-mark {
    width: 36px;
    height: 36px;
    object-fit: contain;
    display: block;
  }
  .nav-logo-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.5rem 0;
  }
  .nav-links a:hover {
    color: var(--color-text-primary);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-cta {
    padding: 0.625rem 1.125rem;
    min-height: auto;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .nav-menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    font-size: 1.375rem;
    color: var(--color-text-primary);
    cursor: pointer;
  }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-lang { display: none; }
    .nav-menu-btn { display: inline-grid; place-items: center; }
    .nav-cta { padding: 0.5rem 0.875rem; font-size: 0.875rem; }
    .nav { padding: 0.625rem 1rem; }
  }
  @media (max-width: 420px) {
    /* The CTA label got longer ("Chơi thử miễn phí" / "Try it free") than the
       old nav copy — drop the wordmark text on narrow phones so the header
       never forces horizontal scroll. */
    .nav-logo-text { display: none; }
  }
</style>
