---
import { getImage } from 'astro:assets';
import type { HeroVideo } from '../data/media';
import { t, type Locale } from '../utils/i18n';
import Icon from './Icon.astro';

interface Props { video: HeroVideo; label: string; locale: Locale }
const { video, label, locale } = Astro.props;
const i = t(locale).media;
const poster = await getImage({ src: video.poster, width: 1280, format: 'avif' });
---
<div class="pv" data-pv>
  <video muted loop playsinline preload="none" poster={poster.src} width="1280" height="800" aria-label={label}>
    {video.webm && <source src={video.webm} type="video/webm" />}
    {video.mp4 && <source src={video.mp4} type="video/mp4" />}
  </video>
  <button type="button" class="pv-toggle" data-pv-toggle aria-label={i.play} data-label-play={i.play} data-label-pause={i.pause}>
    <span data-icon-play><Icon name="Play" size={16} /></span>
    <span data-icon-pause hidden><Icon name="Pause" size={16} /></span>
  </button>
</div>
<script>
  import { shouldAutoplay } from '../lib/autoplay';
  document.querySelectorAll<HTMLElement>('[data-pv]').forEach((root) => {
    const video = root.querySelector('video')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-pv-toggle]')!;
    const sync = () => {
      const playing = !video.paused;
      btn.setAttribute('aria-label', playing ? btn.dataset.labelPause! : btn.dataset.labelPlay!);
      root.querySelector<HTMLElement>('[data-icon-play]')!.hidden = playing;
      root.querySelector<HTMLElement>('[data-icon-pause]')!.hidden = !playing;
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    btn.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const auto = shouldAutoplay({
      reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
      saveData: Boolean(conn?.saveData),
    });
    // Start after load so the poster (LCP) wins the bandwidth race.
    if (auto) addEventListener('load', () => { video.preload = 'auto'; video.play().catch(() => {}); }, { once: true });
  });
</script>
<style>
  .pv { position: relative; width: 100%; height: 100%; }
  .pv-toggle {
    position: absolute; right: 12px; bottom: 12px; width: 36px; height: 36px; border-radius: 50%;
    border: 0; display: grid; place-items: center; cursor: pointer;
    background: rgb(23 21 43 / 0.6); color: var(--color-text-on-primary);
  }
</style>
