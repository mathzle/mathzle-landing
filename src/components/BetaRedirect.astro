---
/**
 * Static redirect page for routes hidden during the beta (D-017). Output is
 * static, so this is an instant meta refresh (+ JS for the fragment on old
 * browsers), noindex, with the target as canonical. Astro.redirect() would
 * do the same but with a 2 s delay and an unstyled "Redirecting…" flash.
 */
interface Props { to: string; locale: 'vi' | 'en' }
const { to, locale } = Astro.props;
const canonical = new URL(to, Astro.site ?? 'https://mathzle.com').href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>Mathzle</title>
  </head>
  <body>
    <script is:inline define:vars={{ to }}>window.location.replace(to);</script>
    <p><a href={to}>Mathzle</a></p>
  </body>
</html>
