---
interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={['tf', className]}><div class="tf-screen"><slot /></div></div>
<style>
  .tf { padding: 14px; border-radius: var(--radius-mk-frame); background: var(--color-mk-ink); box-shadow: var(--shadow-mk-lg); }
  .tf-screen { border-radius: calc(var(--radius-mk-frame) - 10px); overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-surface); }
  .tf-screen :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
