---
import { altPathForLocale, localeLabel, t, type Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
  path: string;
  class?: string;
}
const { locale, path, class: className } = Astro.props;
const other: Locale = locale === 'en' ? 'vi' : 'en';
const altHref = altPathForLocale(path, other);
const label = `${t(locale).a11y.switchLang} ${localeLabel(other)}`;
---
<a
  href={altHref}
  class={['lang-switch', className].filter(Boolean).join(' ')}
  hreflang={other}
  aria-label={label}
>
  <span aria-hidden="true">🌐</span>
  <span>{localeLabel(other)}</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius-sm);
    /* Never wrap: "Tiếng Việt" broke onto two lines once Be Vietnam Pro
       loaded (but not in the fallback font), growing the sticky header 10px
       and shifting the whole page. */
    white-space: nowrap;
  }
  .lang-switch:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-variant);
  }
</style>
