---
/**
 * World-themed pushable card — used in the hub-style worlds grid.
 * The whole card is the tap target. Solid world-color fill, 4px darker
 * bottom border that collapses on :active. Same brand mechanic as the
 * Flutter WorldCard.
 */
interface Props {
  worldColor: string;
  emoji: string;
  title: string;
  subtitle: string;
  badges?: string[];
  href?: string;
}

const { worldColor, emoji, title, subtitle, badges = [], href } = Astro.props;
const styleOverride = `--world-color: ${worldColor}; --world-border: color-mix(in srgb, ${worldColor} 75%, black);`;
---
{
  href ? (
    <a href={href} class="world-card" style={styleOverride}>
      <div class="world-emoji" aria-hidden="true">{emoji}</div>
      <h3 class="world-title">{title}</h3>
      <p class="world-subtitle">{subtitle}</p>
      {badges.length > 0 && (
        <ul class="world-badges">
          {badges.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </a>
  ) : (
    <div class="world-card" style={styleOverride}>
      <div class="world-emoji" aria-hidden="true">{emoji}</div>
      <h3 class="world-title">{title}</h3>
      <p class="world-subtitle">{subtitle}</p>
      {badges.length > 0 && (
        <ul class="world-badges">
          {badges.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </div>
  )
}

<style>
  .world-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--world-color);
    color: var(--color-text-on-primary);
    border-radius: var(--radius-card-lg);
    border-bottom: var(--spacing-push-depth) solid var(--world-border);
    padding: 2rem 1.5rem 1.75rem;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--easing-spring),
      border-bottom-width var(--duration-fast) var(--easing-spring);
  }
  .world-card:active {
    transform: translateY(var(--spacing-push-depth));
    border-bottom-width: 0;
  }
  .world-emoji {
    width: 96px;
    height: 96px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.18);
    display: grid;
    place-items: center;
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }
  .world-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .world-subtitle {
    opacity: 0.92;
    margin-top: 0.25rem;
    font-size: 0.95rem;
  }
  .world-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }
  .world-badges li {
    background: rgb(255 255 255 / 0.22);
    color: var(--color-text-on-primary);
    border-radius: var(--radius-pill);
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.025em;
  }
  @media (prefers-reduced-motion: reduce) {
    .world-card { transition: none; }
    .world-card:active { transform: none; }
  }
</style>
