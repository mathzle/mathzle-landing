---
import { Picture } from 'astro:assets';
import type { World } from '../data/worlds';
interface Props { world: World; name: string; blurb: string; skills: string[]; gradeLabel: string; feature?: boolean }
const { world, name, blurb, skills, gradeLabel, feature = false } = Astro.props;
---
<article class:list={['wc', 'mk-card', 'mk-card--push', { 'wc--feature': feature }]} style={`--card-accent: ${world.color}`}>
  <div class="wc-media">
    <Picture src={world.image} alt="" widths={feature ? [560, 1120] : [360, 720]}
      sizes={feature ? '(min-width: 1024px) 760px, 85vw' : '(min-width: 1024px) 380px, 85vw'}
      formats={['avif', 'webp']} loading="lazy" />
    <span class="wc-grade">{gradeLabel}</span>
  </div>
  <div class="wc-body">
    <h3 class="mk-h3">{name}</h3>
    <p class="wc-blurb">{blurb}</p>
    <ul class="wc-skills">{skills.map((s) => <li>{s}</li>)}</ul>
  </div>
</article>
<style>
  .wc { overflow: hidden; display: flex; flex-direction: column; height: 100%; }
  .wc-media { position: relative; aspect-ratio: 4 / 3; background: color-mix(in srgb, var(--card-accent) 12%, var(--color-surface)); }
  .wc-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease-mk-out); }
  .wc:hover .wc-media :global(img) { transform: scale(1.03); }
  .wc-grade { position: absolute; left: 12px; top: 12px; background: var(--color-surface); border-radius: var(--radius-pill);
    padding: 0.25rem 0.625rem; font-size: 0.75rem; font-weight: 700; color: var(--color-text-primary); }
  .wc-body { padding: 1.25rem 1.25rem 1.5rem; display: grid; gap: 0.5rem; }
  .wc-blurb { margin: 0; color: var(--color-text-secondary); }
  .wc-skills { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .wc-skills li { font-size: 0.8125rem; font-weight: 600; padding: 0.25rem 0.625rem; border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--card-accent) 14%, transparent); color: var(--color-text-primary); }
  .wc--feature .wc-media { aspect-ratio: auto; flex: 1; min-height: 320px; }
  @media (hover: hover) and (min-width: 1024px) {
    .wc:not(.wc--feature) .wc-skills { opacity: 0; transform: translateY(4px); transition: opacity var(--duration-normal), transform var(--duration-normal); }
    .wc:not(.wc--feature):hover .wc-skills, .wc:not(.wc--feature):focus-within .wc-skills { opacity: 1; transform: none; }
  }
</style>
