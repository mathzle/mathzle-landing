---
import Icon from './Icon.astro';
import { copy, visible } from '../lib/copy';
import { t, type Locale } from '../utils/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const l = t(locale).legalPages;
---
<aside class="parent-summary mk-card">
  <h2 class="mk-h3">{l.summaryTitle}</h2>
  <ul>{visible(l.summary).map((s) => <li><Icon name="Check" size={18} /><span set:html={copy(s.text, locale)} /></li>)}</ul>
</aside>
<style>
  .parent-summary { padding: 1.5rem 1.75rem; margin-bottom: 2.5rem; background: var(--color-mk-canvas-tint); }
  ul { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  li { display: flex; gap: 0.5rem; }
  li :global(.icon) { color: var(--color-success); margin-top: 3px; }
</style>
