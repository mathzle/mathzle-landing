---
interface Props { url?: string; class?: string }
const { url = 'app.mathzle.com', class: className } = Astro.props;
---
<div class:list={['bf', className]}>
  <div class="bf-bar" aria-hidden="true">
    <span class="bf-dots"><i></i><i></i><i></i></span>
    <span class="bf-url">{url}</span>
  </div>
  <div class="bf-body"><slot /></div>
</div>
<style>
  .bf { border-radius: var(--radius-mk-frame); background: var(--color-surface); border: 1px solid var(--color-mk-hairline); box-shadow: var(--shadow-mk-lg); overflow: hidden; }
  .bf-bar { display: flex; align-items: center; gap: 1rem; padding: 0.625rem 1rem; border-bottom: 1px solid var(--color-mk-hairline); background: var(--color-mk-canvas-mist); }
  .bf-dots { display: inline-flex; gap: 6px; }
  .bf-dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--color-mk-hairline-strong); }
  .bf-url { flex: 1; max-width: 22rem; margin-inline: auto; text-align: center; font-size: 0.75rem; color: var(--color-text-secondary); background: var(--color-surface); border-radius: var(--radius-pill); padding: 0.25rem 0.75rem; }
  .bf-body { aspect-ratio: 16 / 10; position: relative; }
  /* Only the frame's own media fills it — never images nested inside slotted
     widgets (e.g. the TryAProblem mascot). */
  .bf-body > :global(img), .bf-body > :global(picture img), .bf-body > :global(video), .bf-body > :global(.pv video) {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
</style>
