---
import { site } from '../data/site';
import { t, type Locale } from '../utils/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const a = t(locale).actions;
---
<div class="sticky-cta" data-sticky-cta data-visible="false">
  <a href={site.appUrl} class="btn-push" data-track="sticky-cta" target="_blank" rel="noopener noreferrer" tabindex="-1">{a.primaryShort}</a>
</div>
<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.getElementById('hero');
  const final = document.getElementById('final-cta');
  if (bar && hero) {
    const seen = new Map<Element, boolean>();
    const update = () => {
      const show = !seen.get(hero) && !(final && seen.get(final));
      bar.dataset.visible = String(show);
      bar.querySelector('a')!.tabIndex = show ? 0 : -1;
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => seen.set(e.target, e.isIntersecting));
      update();
    });
    io.observe(hero);
    if (final) io.observe(final);
  }
</script>
<style>
  .sticky-cta { display: none; }
  @media (max-width: 768px) {
    .sticky-cta {
      display: block; position: fixed; inset: auto 0 0 0; z-index: 20;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(8px); border-top: 1px solid var(--color-mk-hairline);
      transform: translateY(110%); transition: transform var(--duration-normal) var(--ease-mk-out);
    }
    .sticky-cta[data-visible='true'] { transform: none; }
    .sticky-cta .btn-push { width: 100%; min-height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) { .sticky-cta { transition: none; } }
</style>
