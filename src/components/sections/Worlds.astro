---
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import WorldCard from '../WorldCard.astro';
import CurriculumTable from './CurriculumTable.astro';
import { WORLDS } from '../../data/worlds';
import { t, type Locale } from '../../utils/i18n';
interface Props { locale: Locale; featured?: string }
const { locale, featured = 'ocean' } = Astro.props;
const w = t(locale).worlds;
const ordered = [...WORLDS].sort((a, b) => (a.id === featured ? -1 : b.id === featured ? 1 : 0));
---
<Section id="worlds" tone="mist" width="wide" labelledby="worlds-title">
  <SectionHeader id="worlds-title" locale={locale} eyebrow={w.eyebrow} title={w.title} lead={w.lead} accent="var(--color-world-sunset)" />
  <ul class="bento" aria-label={w.carouselLabel}>
    {ordered.map((world, n) => (
      <li class:list={['bento-item', { 'bento-item--feature': n === 0 }]}>
        <WorldCard
          world={world}
          name={w[world.id].name}
          blurb={w[world.id].blurb}
          skills={w[world.id].skills}
          gradeLabel={w.gradeLabel.replace('{from}', String(world.grades.from)).replace('{to}', String(world.grades.to))}
          feature={n === 0}
        />
      </li>
    ))}
  </ul>
  <CurriculumTable locale={locale} />
</Section>
<style>
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .bento-item--feature { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 1023px) {
    .bento { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 1rem; padding-bottom: 1rem;
      margin-inline: -1rem; padding-inline: 1rem; scrollbar-width: thin; }
    .bento-item { flex: 0 0 85%; scroll-snap-align: start; }
  }
</style>
