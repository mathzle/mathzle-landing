---
import { t, type Locale } from '../../utils/i18n';
import OpChip from '../OpChip.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).howItWorks;

// Each step gets a world-color accent + a cube-face operator that visually
// rhymes with the logo. ? for "pick", ▶ for "play", ★ for "earn".
const steps = [
  { symbol: '?', accent: 'var(--color-world-ocean)',  ...i.step1 },
  { symbol: '▶', accent: 'var(--color-world-sunset)', ...i.step2 },
  { symbol: '★', accent: 'var(--color-reward)',       ...i.step3 },
];
---
<section id="how-it-works" class="how">
  <h2 class="section-title">{i.title}</h2>
  <ol class="how-grid">
    {steps.map((s, idx) => (
      <li class="how-step" style={`--accent: ${s.accent}`}>
        <div class="how-num">{idx + 1}</div>
        <div class="how-chip-wrap">
          <OpChip symbol={s.symbol} color={s.accent} size={80} tilt={-5} />
        </div>
        <h3 class="how-step-title">{s.title}</h3>
        <p class="how-step-body">{s.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .how {
    padding: 5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }
  .how-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    counter-reset: step;
  }
  .how-step {
    position: relative;
    text-align: center;
    padding: 2.5rem 1.5rem 2rem;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    border-bottom: var(--spacing-push-depth) solid var(--accent, var(--color-border));
    transition:
      transform var(--duration-normal) var(--easing-spring),
      box-shadow var(--duration-normal) var(--easing-spring);
  }
  .how-step:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgb(45 42 74 / 0.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .how-step { transition: none; }
    .how-step:hover { transform: none; box-shadow: none; }
  }
  .how-num {
    position: absolute;
    top: -16px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--color-text-on-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .how-chip-wrap {
    margin: 0.75rem 0 1.25rem;
  }
  .how-step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .how-step-body {
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
