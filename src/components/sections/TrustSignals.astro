---
import { t, type Locale } from '../../utils/i18n';
import OpChip from '../OpChip.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).trust;

// Same cube-face brand language used elsewhere — three trust pillars,
// each glyph hints at its meaning: ✓ safety, ✎ educator-built, ☼ language.
const signals = [
  { symbol: '✓', accent: 'var(--color-success)',     ...i.safe },
  { symbol: '✎', accent: 'var(--color-primary)',     ...i.educator },
  { symbol: '☼', accent: 'var(--color-world-ocean)', ...i.multilingual },
];
---
<section id="trust" class="trust">
  <h2 class="section-title">{i.title}</h2>
  <div class="trust-grid">
    {signals.map((s) => (
      <div class="trust-card" style={`--accent: ${s.accent}`}>
        <div class="trust-chip-wrap">
          <OpChip symbol={s.symbol} color={s.accent} size={64} tilt={-5} />
        </div>
        <h3 class="trust-card-title">{s.title}</h3>
        <p class="trust-card-body">{s.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .trust {
    padding: 5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .trust-card {
    text-align: center;
    padding: 2rem 1.5rem;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    border-bottom: var(--spacing-push-depth-small) solid var(--color-border);
    transition:
      transform var(--duration-normal) var(--easing-spring),
      border-bottom-color var(--duration-normal) var(--easing-spring),
      border-bottom-width var(--duration-normal) var(--easing-spring);
  }
  .trust-card:hover {
    transform: translateY(-2px);
    border-bottom-color: var(--accent);
    border-bottom-width: var(--spacing-push-depth);
  }
  .trust-chip-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .trust-card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .trust-card-body {
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .trust-card { transition: none; }
    .trust-card:hover { transform: none; }
  }
</style>
