---
import { t, type Locale } from '../../utils/i18n';
import Mascot from '../Mascot.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).screenshots;

/**
 * Browser-frame mockups, not phone mockups — the product is a web app.
 * Real screenshots replace the placeholder gradients post-launch.
 */
const frames = [
  { accent: 'var(--color-world-ocean)',  label: 'Lesson view',      emoji: '🌊', mascot: 'idle'  as const },
  { accent: 'var(--color-world-sunset)', label: 'Quiz feedback',    emoji: '⛰️', mascot: 'cheer' as const },
  { accent: 'var(--color-world-berry)',  label: 'Family dashboard', emoji: '🍓', mascot: 'wave'  as const },
];
---
<section id="screenshots" class="screenshots">
  <h2 class="section-title">{i.title}</h2>
  <p class="section-sub">{i.subtitle}</p>
  <div class="screenshots-row">
    {frames.map((f) => (
      <div class="browser-frame" style={`--accent: ${f.accent}`}>
        <div class="browser-chrome">
          <span class="browser-dot" aria-hidden="true"></span>
          <span class="browser-dot" aria-hidden="true"></span>
          <span class="browser-dot" aria-hidden="true"></span>
          <span class="browser-url">app.mathzle.com</span>
        </div>
        <div class="browser-body">
          <div class="browser-placeholder">
            <span class="browser-emoji" aria-hidden="true">{f.emoji}</span>
            <Mascot state={f.mascot} size={64} />
            <p class="browser-label">{f.label}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .screenshots {
    padding: 5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .section-sub {
    color: var(--color-text-secondary);
    margin-bottom: 3rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }
  .screenshots-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .browser-frame {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    border-bottom: var(--spacing-push-depth) solid var(--accent);
    box-shadow: 0 8px 24px rgb(45 42 74 / 0.08);
  }
  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
    background: var(--color-surface-variant);
    border-bottom: 1px solid var(--color-border);
  }
  .browser-dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: var(--color-text-tertiary);
    opacity: 0.5;
  }
  .browser-dot:nth-child(1) { background: #ff5f57; }
  .browser-dot:nth-child(2) { background: #ffbd2e; }
  .browser-dot:nth-child(3) { background: #28c840; }
  .browser-url {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    font-family: ui-monospace, monospace;
  }
  .browser-body {
    aspect-ratio: 16 / 10;
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--accent) 10%, var(--color-bg)),
      color-mix(in srgb, var(--accent) 4%, var(--color-bg)));
    padding: 1.5rem;
  }
  .browser-placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .browser-emoji {
    font-size: 3rem;
  }
  .browser-label {
    color: var(--color-text-secondary);
    font-weight: 500;
    font-size: 0.875rem;
  }
</style>
