---
import { t, type Locale } from '../../utils/i18n';
import OpChip from '../OpChip.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).screenshots;

/**
 * Pre-launch "world preview" cards — chunky tilted stickers, not browser
 * mockups. Each card hints at a real screen (lesson / quiz / family) using
 * the cube logo as the recurring brand object. When real screenshots ship,
 * the cube image swaps out for the screen capture inside the same frame.
 */
const frames = [
  { accent: 'var(--color-world-ocean)',  label: 'Lesson view',      symbol: '+', tilt: -3 },
  { accent: 'var(--color-world-sunset)', label: 'Quiz feedback',    symbol: '✓', tilt:  2 },
  { accent: 'var(--color-world-berry)',  label: 'Family dashboard', symbol: '★', tilt: -2 },
];
---
<section id="screenshots" class="screenshots">
  <h2 class="section-title">{i.title}</h2>
  <p class="section-sub">{i.subtitle}</p>
  <div class="screenshots-row">
    {frames.map((f) => (
      <figure
        class="preview-card"
        style={`--accent: ${f.accent}; --card-tilt: ${f.tilt}deg`}
      >
        <div class="preview-stage">
          <img
            src="/brand/logo.png"
            alt=""
            width="220"
            height="220"
            class="preview-cube"
            loading="lazy"
            decoding="async"
          />
          <div class="preview-chip">
            <OpChip symbol={f.symbol} color={f.accent} size={48} tilt={-6} />
          </div>
        </div>
        <figcaption class="preview-label">{f.label}</figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .screenshots {
    padding: 5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .section-sub {
    color: var(--color-text-secondary);
    margin-bottom: 3rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }
  .screenshots-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
    padding-top: 0.5rem;
  }

  .preview-card {
    margin: 0;
    background: var(--color-surface);
    border-radius: var(--radius-card-lg);
    border-bottom: var(--spacing-push-depth) solid var(--accent);
    padding: 1.25rem 1rem 1.25rem;
    transform: rotate(var(--card-tilt));
    box-shadow:
      0 14px 28px rgb(45 42 74 / 0.08),
      0 4px 8px rgb(45 42 74 / 0.04);
    transition: transform var(--duration-normal) var(--easing-spring);
  }
  .preview-card:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .preview-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(circle at 30% 25%,
        color-mix(in srgb, var(--accent) 18%, var(--color-bg)) 0%,
        color-mix(in srgb, var(--accent)  6%, var(--color-bg)) 60%,
        var(--color-bg) 100%);
    border-radius: var(--radius-card);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .preview-cube {
    width: 62%;
    height: auto;
    filter: drop-shadow(0 10px 18px rgb(45 42 74 / 0.12));
    transform: rotate(calc(var(--card-tilt) * -1));
  }

  .preview-chip {
    position: absolute;
    top: 12px;
    right: 12px;
  }

  .preview-label {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-card { transition: none; }
    .preview-card:hover { transform: rotate(var(--card-tilt)); }
  }
</style>
