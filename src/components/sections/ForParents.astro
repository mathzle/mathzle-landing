---
import { Picture } from 'astro:assets';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import TabletFrame from '../TabletFrame.astro';
import Icon from '../Icon.astro';
import { screen } from '../../data/media';
import { resolveClaim } from '../../data/claims';
import { copy, visible } from '../../lib/copy';
import { t, type Locale } from '../../utils/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const i = t(locale).parents;
const shot = screen('family-dashboard');
const show = resolveClaim('skillReport').show;
---
{show && (
  <Section id="parents" tone="canvas" labelledby="parents-title">
    <div class:list={['fp', { 'fp--noshot': !shot }]}>
      {shot && (
        <div class="fp-visual reveal">
          <TabletFrame>
            <Picture src={shot} alt={i.screenAlt} widths={[640, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" formats={['avif', 'webp']} loading="lazy" />
          </TabletFrame>
        </div>
      )}
      <div class="fp-copy">
        <SectionHeader id="parents-title" locale={locale} eyebrow={i.eyebrow} title={i.title} lead={i.lead} align="center" />
        <div class="fp-cols">
          {[{ title: i.kidTitle, items: visible(i.kid) }, { title: i.parentTitle, items: visible(i.parent) }].map((col) => (
            <div class="fp-col">
              <h3 class="mk-caption fp-col-title">{col.title}</h3>
              <ul>{col.items.map((it) => <li><Icon name="Check" size={18} /><span set:html={copy(it.text, locale)} /></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>
)}
<style>
  .fp { display: grid; grid-template-columns: 7fr 5fr; gap: 4rem; align-items: center; }
  .fp--noshot { grid-template-columns: 1fr; max-width: 820px; margin-inline: auto; }
  .fp-copy :global(.sh) { text-align: left; justify-items: start; margin-bottom: 2rem; }
  .fp-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .fp-col-title { text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.75rem; }
  .fp-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .fp-col li { display: flex; gap: 0.5rem; font-weight: 600; }
  .fp-col :global(.icon) { color: var(--color-success); margin-top: 2px; }
  @media (max-width: 900px) { .fp { grid-template-columns: 1fr; gap: 2.5rem; } }
  @media (max-width: 520px) { .fp-cols { grid-template-columns: 1fr; } }
</style>
