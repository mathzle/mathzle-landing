---
import Section from '../Section.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Mascot from '../Mascot.astro';
import SignupForm from '../islands/SignupForm';
import { site } from '../../data/site';
import { copy } from '../../lib/copy';
import { t, type Locale } from '../../utils/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const f = d.final;
---
<Section id="final-cta" tone="ink" labelledby="final-title">
  <div class="fc">
    <Mascot state="cheer" size={140} />
    <h2 id="final-title" class="mk-h2" set:html={copy(f.title, locale)} />
    <Button href={site.appUrl} size="lg" track="cta-play-final" external>{d.actions.primary} <Icon name="ArrowRight" size={20} /></Button>
    <p class="fc-reassure">{d.actions.reassure.join(' · ')}</p>
    <details class="fc-news">
      <summary>{f.newsletterToggle}</summary>
      <p class="mk-body">{f.newsletterBody}</p>
      <SignupForm locale={locale} source="newsletter" placeholder={d.cta.placeholder} button={d.cta.button}
        success={d.cta.success} error={d.cta.error} invalid={d.cta.invalid} variant="ink" client:only="preact" />
    </details>
  </div>
</Section>
<style>
  .fc { display: grid; justify-items: center; text-align: center; gap: 1.25rem; max-width: 720px; margin-inline: auto; }
  .fc :global(.mk-h2) { color: var(--color-mk-ink-text); }
  .fc-reassure { margin: 0; color: var(--color-mk-ink-text-muted); font-size: 0.9375rem; }
  .fc-news { margin-top: 1.5rem; width: 100%; }
  .fc-news summary { cursor: pointer; color: var(--color-mk-ink-text); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .fc-news[open] { display: grid; justify-items: center; gap: 1rem; }
  .fc-news :global(.cta-form) { width: 100%; justify-content: center; }
</style>
