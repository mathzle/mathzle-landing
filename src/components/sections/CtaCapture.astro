---
import { t, type Locale } from '../../utils/i18n';
import SignupForm from '../islands/SignupForm';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).cta;
---
<section id="signup" class="cta">
  <div class="cta-decoration" aria-hidden="true"></div>
  <div class="cta-inner">
    <h2 class="cta-title">{i.title}</h2>
    <p class="cta-sub">{i.subtitle}</p>
    <SignupForm
      locale={locale}
      source="newsletter"
      placeholder={i.placeholder}
      button={i.button}
      success={i.success}
      error={i.error}
      invalid={i.invalid}
      client:only="preact"
    />
  </div>
</section>

<style is:global>
  .cta {
    position: relative;
    padding: 5rem 1.5rem;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    overflow: hidden;
  }
  /* Solid pastel card — replaces the diagonal gradient (DESIGN.md anti-pattern).
     Same warm pop without the AI-slop signal. */
  .cta-decoration {
    position: absolute;
    inset: 1rem;
    border-radius: var(--radius-card-lg);
    background: var(--color-primary-light);
    border-bottom: var(--spacing-push-depth) solid
      color-mix(in srgb, var(--color-primary) 30%, var(--color-border));
    z-index: -1;
  }
  .cta-inner {
    padding: 2rem 1rem;
  }
  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .cta-sub {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 1.5;
  }
  .cta-form {
    margin: 0 auto;
  }
</style>
