---
import { getEntry } from 'astro:content';
import FaqAccordion from '../islands/FaqAccordion';
import { t, type Locale } from '../../utils/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).faq;

const entry = await getEntry('faq', locale);
const items = entry?.data.items ?? [];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
};
---
<section id="faq" class="faq">
  <h2 class="section-title">{i.title}</h2>
  <FaqAccordion items={items} client:only="preact" />
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style is:global>
  .faq {
    padding: 5rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .faq .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }
  .faq-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-q {
    width: 100%;
    padding: 1.25rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 1.125rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    color: var(--color-text-primary);
  }
  .faq-q:hover .faq-q-text {
    color: var(--color-primary);
  }
  .faq-chev {
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-text-tertiary);
    font-weight: 300;
    min-width: 1rem;
    text-align: center;
  }
  .faq-a {
    padding: 0 0 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
