---
import { getEntry } from 'astro:content';
import Section from '../Section.astro';
import Mascot from '../Mascot.astro';
import FaqAccordion from '../islands/FaqAccordion';
import { copy, copyText, visible } from '../../lib/copy';
import { site } from '../../data/site';
import { t, type Locale } from '../../utils/i18n';

type Category = 'learning' | 'safety' | 'billing' | 'tech';
interface Props { locale: Locale; categories?: Category[]; tone?: 'canvas' | 'tint' }
const { locale, categories, tone = 'canvas' } = Astro.props;
const i = t(locale).faq;
const all = visible((await getEntry('faq', locale))?.data.items ?? []);
const items = categories ? all.filter((q) => categories.includes(q.category)) : all;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: copyText(q.answer, locale) },
  })),
};
---
<Section id="faq" tone={tone} labelledby="faq-title">
  <div class="faq-grid">
    <aside class="faq-side">
      <h2 id="faq-title" class="mk-h2">{i.title}</h2>
      <Mascot state="wave" size={88} />
      <p class="faq-ask">{i.askTitle}</p>
      {site.contact.zaloUrl && <a class="btn-text" href={site.contact.zaloUrl} target="_blank" rel="noopener noreferrer">{i.askZalo} →</a>}
      {site.contact.email && <a class="btn-text" href={`mailto:${site.contact.email}`}>{i.askEmail} →</a>}
    </aside>
    <FaqAccordion items={items.map((q) => ({ id: q.id, question: q.question, answerHtml: copy(q.answer, locale) }))} client:only="preact" />
  </div>
</Section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style is:global>
  .faq-grid { display: grid; grid-template-columns: 4fr 8fr; gap: 4rem; align-items: start; }
  .faq-side { position: sticky; top: 7rem; display: grid; gap: 1rem; justify-items: start; }
  .faq-ask { margin: 0.5rem 0 0; font-weight: 700; }
  .faq-list { list-style: none; padding: 0; margin: 0; min-height: 24rem; }
  .faq-item { border-bottom: 1px solid var(--color-mk-hairline-strong); scroll-margin-top: 6rem; }
  .faq-q { width: 100%; padding: 1.375rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    background: transparent; border: 0; font: inherit; font-size: 1.125rem; font-weight: 700; text-align: left; cursor: pointer; color: var(--color-text-primary); }
  .faq-q:hover .faq-q-text { color: var(--color-primary); }
  .faq-chev { font-size: 1.5rem; line-height: 1; color: var(--color-mk-text-tertiary); min-width: 1rem; text-align: center; }
  .faq-a { padding: 0 0 1.5rem; color: var(--color-text-secondary); line-height: 1.65; max-width: 62ch; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; gap: 2rem; } .faq-side { position: static; } }
</style>
