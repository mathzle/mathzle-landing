---
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';
import { copy, visible } from '../../lib/copy';
import { t, type Locale } from '../../utils/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const i = t(locale).safety;
---
<Section id="safety" tone="ink" pattern="dots" labelledby="safety-title">
  <SectionHeader id="safety-title" locale={locale} eyebrow={i.eyebrow} title={i.title} lead={i.lead} accent="var(--color-world-mint)" />
  <ul class="sg">
    {visible(i.items).map((it) => (
      <li class="sg-item reveal">
        <span class="sg-icon"><Icon name={it.icon as IconName} size={24} /></span>
        <h3 class="mk-h3" set:html={copy(it.title, locale)} />
        <p class="mk-body">{it.body}</p>
      </li>
    ))}
  </ul>
  <a class="sg-link" href={`/${locale}/privacy/`}>{i.privacyLink} →</a>
</Section>
<style>
  .sg { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: rgb(255 255 255 / 0.08); border-radius: var(--radius-card-lg); overflow: hidden; }
  .sg-item { background: var(--color-mk-ink-surface); padding: 1.75rem; display: grid; gap: 0.625rem; align-content: start; }
  .sg-item :global(.mk-h3) { color: var(--color-mk-ink-text); font-size: 1.125rem; }
  .sg-item :global(.mk-body) { margin: 0; font-size: 0.9375rem; }
  .sg-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
    background: color-mix(in srgb, var(--color-world-mint) 18%, transparent); color: var(--color-world-mint); }
  .sg-link { display: inline-block; margin-top: 2rem; font-weight: 700; color: var(--color-mk-ink-text); text-underline-offset: 4px; }
  @media (max-width: 900px) { .sg { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .sg { grid-template-columns: 1fr; } }
</style>
