---
import { Picture } from 'astro:assets';
import Section from '../Section.astro';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import BrowserFrame from '../BrowserFrame.astro';
import ProductVideo from '../ProductVideo.astro';
import TryAProblem from '../islands/TryAProblem';
import { heroVideo } from '../../data/media';
import { WORLDS } from '../../data/worlds';
import { site } from '../../data/site';
import { copy } from '../../lib/copy';
import { t, type Locale } from '../../utils/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const i = d.hero;
const a = d.actions;
const video = heroVideo();
const tryProps = {
  strings: d.try,
  mascot: { idle: '/mascot/blob-idle.svg', cheer: '/mascot/blob-cheer.svg', think: '/mascot/blob-think.svg' },
};
---
<Section id="hero" tone="canvas" width="wide" labelledby="hero-title" class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <Eyebrow><Fragment set:html={copy(i.eyebrow, locale)} /></Eyebrow>
      <h1 id="hero-title" class="mk-display" set:html={copy(i.headline, locale)} />
      <p class="mk-lead" set:html={copy(i.lead, locale)} />
      <div class="hero-ctas">
        <Button href={site.appUrl} size="lg" track="cta-play-hero" external>
          {a.primary} <Icon name="ArrowRight" size={20} />
        </Button>
        <a href="#worlds" class="btn-text" data-track="cta-learn-hero">{a.secondary} ↓</a>
      </div>
      <ul class="hero-reassure" aria-label={a.reassureLabel}>
        {a.reassure.map((r) => <li><Icon name="Check" size={16} />{r}</li>)}
      </ul>
    </div>

    <div class="hero-visual">
      <BrowserFrame>
        {video ? (
          <ProductVideo video={video} label={i.frameLabel} locale={locale} />
        ) : (
          <div class="hero-stage">
            <Picture src={WORLDS[0].image} alt="" widths={[640, 960]} sizes="(min-width: 1024px) 50vw, 100vw"
              formats={['avif', 'webp']} class="hero-stage-bg" loading="eager" fetchpriority="high" />
            <div class="hero-stage-slot">
              <TryAProblem variant="stage" {...tryProps} client:only="preact" />
            </div>
          </div>
        )}
      </BrowserFrame>
      {video && (
        <div class="hero-sticker">
          <TryAProblem variant="sticker" {...tryProps} client:only="preact" />
        </div>
      )}
    </div>
  </div>
</Section>

<style>
  /* `.hero` sits on the Section root (another component) → must be global. */
  :global(.hero) { padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 8vw, 7rem); }
  .hero-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: center; }
  .hero-reassure { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .hero-reassure li { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.9375rem; font-weight: 500; color: var(--color-text-secondary); }
  .hero-reassure :global(.icon) { color: var(--color-success); }
  .hero-visual { position: relative; margin-right: -2.5rem; }
  .hero-visual::before {
    content: ''; position: absolute; inset: -12% -8%; z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-primary) 10%, transparent), transparent);
  }
  .hero-stage { position: relative; width: 100%; height: 100%; }
  .hero-stage :global(.hero-stage-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; }
  .hero-stage-slot { position: absolute; inset: 0; display: grid; place-items: center; padding: 1.5rem; }
  .hero-sticker { position: absolute; left: -2rem; bottom: -2.5rem; width: min(300px, 70%); min-height: 236px; }
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; }
    /* `.hero-sticker` goes static below — nothing else needs the bleed room
       any more, so contain the decorative glow (`::before`) instead of
       letting it push the page into horizontal scroll. */
    .hero-visual { margin-right: 0; overflow: hidden; }
    .hero-sticker { position: static; width: 100%; margin-top: 1rem; }
  }
</style>

<style is:global>
  .tap { background: var(--color-surface); border-radius: var(--radius-card-lg); padding: 1.25rem; box-shadow: var(--shadow-mk-lg); border: 1px solid var(--color-mk-hairline); width: min(100%, 340px); min-height: 236px; display: grid; gap: 0.75rem; }
  .tap-head { display: flex; gap: 0.75rem; align-items: center; }
  .tap-title { margin: 0; font-weight: 800; }
  .tap-prompt { margin: 0; font-size: 0.875rem; color: var(--color-text-secondary); }
  .tap-q { margin: 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .tap-blank { color: var(--color-primary); }
  .tap-choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .tap-choice {
    min-height: 52px; font: inherit; font-size: 1.25rem; font-weight: 800; cursor: pointer;
    background: var(--color-surface); color: var(--color-text-primary);
    border: 1px solid var(--color-mk-hairline-strong); border-bottom: var(--spacing-push-depth) solid var(--color-mk-hairline-strong);
    border-radius: var(--radius-button); transition: transform var(--duration-fast) var(--easing-spring);
  }
  .tap-choice:active { transform: translateY(var(--spacing-push-depth)); border-bottom-width: 1px; }
  .tap-choice.is-right { background: var(--color-success); color: var(--color-text-on-primary); border-color: color-mix(in srgb, var(--color-success) 70%, black); }
  .tap-choice.is-wrong { border-color: var(--color-warning); }
  .tap-feedback { margin: 0; min-height: 2.6em; font-size: 0.875rem; color: var(--color-text-secondary); }
  .tap-next { justify-self: start; background: none; border: 0; padding: 0; font: inherit; font-weight: 700; color: var(--color-primary); cursor: pointer; }
</style>
