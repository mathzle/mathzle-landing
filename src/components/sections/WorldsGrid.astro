---
import { t, type Locale } from '../../utils/i18n';
import { WORLDS } from '../../data/worlds';
import WorldCard from '../WorldCard.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const w = t(locale).worlds;
---
<section id="worlds" class="worlds">
  <h2 class="section-title">{w.title}</h2>
  <div class="worlds-grid">
    {WORLDS.map((world) => {
      const data = w[world.id];
      return (
        <WorldCard
          worldColor={world.color}
          symbol={world.symbol}
          image={world.image}
          imageAlt={`${data.name} — ${data.subtitle}`}
          title={data.name}
          subtitle={data.subtitle}
          badges={data.badges}
        />
      );
    })}
  </div>
</section>

<style>
  .worlds {
    padding: 5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }
  /* 6 worlds → 3 columns × 2 rows on desktop, 2 columns × 3 rows
     on tablet, single column on mobile. Explicit columns beat
     auto-fit here because we want the 2-row rhythm to read as
     "six worlds, six ways" — not a chaotic auto-flowed strip. */
  .worlds-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 900px) {
    .worlds-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .worlds-grid { grid-template-columns: 1fr; }
  }
</style>
