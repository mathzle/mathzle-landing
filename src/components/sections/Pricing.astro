---
import { t, type Locale } from '../../utils/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).pricing;
const webAppUrl = 'https://app.mathzle.com'; // TODO(launch): final URL
---
<section id="pricing" class="pricing">
  <h2 class="section-title">{i.title}</h2>
  <div class="pricing-grid">
    <div class="price-card">
      <div class="price-card-header">
        <h3 class="price-title">{i.freeTitle}</h3>
        <p class="price-amount">{i.freePrice}</p>
      </div>
      <ul class="price-list">
        {i.freeBullets.map((b) => <li>{b}</li>)}
      </ul>
      <a href={webAppUrl} class="btn-push price-cta" data-track="cta-pricing-free" target="_blank" rel="noopener noreferrer">
        {i.freeCta}
      </a>
    </div>
    <div class="price-card price-card-premium">
      <div class="price-card-header">
        <h3 class="price-title">{i.premiumTitle}</h3>
        <p class="price-amount">{i.premiumPrice}</p>
      </div>
      <ul class="price-list">
        {i.premiumBullets.map((b) => <li>{b}</li>)}
      </ul>
      <a href={webAppUrl} class="btn-push price-cta price-cta-premium" data-track="cta-pricing-premium" target="_blank" rel="noopener noreferrer">
        {i.premiumCta}
      </a>
      <p class="price-note">{i.premiumNote}</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: 5rem 1.5rem;
    max-width: 880px;
    margin: 0 auto;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .pricing-grid { grid-template-columns: 1fr; }
  }
  .price-card {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: var(--radius-card-lg);
    border-bottom: var(--spacing-push-depth) solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .price-card-premium {
    background: linear-gradient(150deg, var(--color-primary), var(--color-secondary));
    color: var(--color-text-on-primary);
    border-bottom-color: var(--color-primary-dark);
  }
  .price-card-header {
    text-align: center;
  }
  .price-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .price-amount {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    margin-top: 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .price-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .price-list li {
    padding-left: 1.5rem;
    position: relative;
  }
  .price-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: var(--color-success);
  }
  .price-card-premium .price-list li::before {
    color: var(--color-reward);
  }
  .price-cta {
    width: 100%;
    margin-top: auto;
  }
  .price-cta-premium {
    background: var(--color-text-on-primary);
    color: var(--color-primary);
    border-bottom-color: rgb(255 255 255 / 0.4);
  }
  .price-note {
    font-size: 0.8rem;
    opacity: 0.85;
    text-align: center;
  }
</style>
