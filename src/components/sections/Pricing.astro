---
import { t, type Locale } from '../../utils/i18n';
import { site } from '../../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale).pricing;
const webAppUrl = site.appUrl;
const premiumHref = site.premium.onSale ? site.appUrl : '#signup';
---
<section id="pricing" class="pricing">
  <h2 class="section-title">{i.title}</h2>
  <div class="pricing-grid">
    <div class="price-card">
      <div class="price-card-header">
        <h3 class="price-title">{i.freeTitle}</h3>
        <p class="price-amount">{i.freePrice}</p>
      </div>
      <ul class="price-list">
        {i.freeBullets.map((b) => <li>{b}</li>)}
      </ul>
      <a href={webAppUrl} class="btn-push price-cta" data-track="cta-pricing-free" target="_blank" rel="noopener noreferrer">
        {i.freeCta}
      </a>
    </div>
    <div class="price-card price-card-premium">
      <img
        src="/brand/logo.png"
        alt=""
        width="120"
        height="120"
        class="price-cube-decoration"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <div class="price-card-header">
        <h3 class="price-title">{i.premiumTitle}</h3>
        <p class="price-amount">{i.premiumPrice}</p>
      </div>
      <ul class="price-list">
        {i.premiumBullets.map((b) => <li>{b}</li>)}
      </ul>
      <a
        href={premiumHref}
        class="btn-push price-cta price-cta-premium"
        data-track="cta-pricing-premium"
        {...(site.premium.onSale ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {i.premiumCta}
      </a>
      <p class="price-note">{i.premiumNote}</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: 5rem 1.5rem;
    max-width: 880px;
    margin: 0 auto;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .pricing-grid { grid-template-columns: 1fr; }
  }
  .price-card {
    position: relative;
    background: var(--color-surface);
    padding: 2rem;
    border-radius: var(--radius-card-lg);
    border-bottom: var(--spacing-push-depth) solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    overflow: hidden;
    transition:
      transform var(--duration-normal) var(--easing-spring),
      box-shadow var(--duration-normal) var(--easing-spring);
  }
  .price-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgb(45 42 74 / 0.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .price-card { transition: none; }
    .price-card:hover { transform: none; box-shadow: none; }
  }
  /* Premium card — solid brand color, not a gradient (DESIGN.md anti-pattern).
     The cube logo decorates the corner instead of the gradient sweep. */
  .price-card-premium {
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    border-bottom-color: var(--color-primary-dark);
  }
  .price-cube-decoration {
    position: absolute;
    top: -18px;
    right: -22px;
    width: 120px;
    height: 120px;
    opacity: 0.22;
    transform: rotate(14deg);
    pointer-events: none;
  }
  .price-card-header {
    text-align: center;
  }
  .price-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .price-amount {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    margin-top: 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .price-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .price-list li {
    padding-left: 1.5rem;
    position: relative;
  }
  .price-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: var(--color-success);
  }
  .price-card-premium .price-list li::before {
    color: var(--color-reward);
  }
  .price-cta {
    width: 100%;
    margin-top: auto;
  }
  .price-cta-premium {
    background: var(--color-text-on-primary);
    color: var(--color-primary);
    border-bottom-color: rgb(255 255 255 / 0.4);
  }
  .price-note {
    font-size: 0.8rem;
    opacity: 0.85;
    text-align: center;
  }
</style>
