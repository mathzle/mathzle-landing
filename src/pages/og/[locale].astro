---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { WORLDS } from '../../data/worlds';
import { screen } from '../../data/media';
import { copy } from '../../lib/copy';
import { t, type Locale } from '../../utils/i18n';
export function getStaticPaths() { return [{ params: { locale: 'vi' } }, { params: { locale: 'en' } }]; }
const locale = Astro.params.locale as Locale;
const h = t(locale).hero;
const art = screen('lesson-play') ?? WORLDS[0].image;
---
<Base title="og" description="og" locale={locale} path={`/${locale}/`} noindex>
  <div class="og">
    <div class="og-copy">
      <p class="og-brand"><img src="/brand/logo.png" width="56" height="56" alt="" /> Mathzle</p>
      <h1 class="og-h" set:html={copy(h.headline, locale)} />
    </div>
    <div class="og-art"><Picture src={art} alt="" widths={[640]} formats={['png']} loading="eager" /></div>
  </div>
</Base>
<style>
  .og { width: 1200px; height: 630px; display: grid; grid-template-columns: 1.1fr 1fr; background: var(--color-mk-canvas); overflow: hidden; }
  .og-copy { padding: 64px; display: grid; align-content: space-between; }
  .og-brand { display: flex; align-items: center; gap: 12px; font-size: 32px; font-weight: 800; margin: 0; }
  .og-h { font-size: 60px; line-height: 1.05; letter-spacing: -0.03em; font-weight: 800; margin: 0; }
  .og-art { background: var(--color-mk-canvas-warm); display: grid; place-items: center; }
  .og-art :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
