---
/**
 * Root language sniff. A static page: the script sends Vietnamese browsers
 * to /vi/ and everyone else to /en/; meta refresh covers no-JS.
 *
 * There is deliberately no `_redirects` rule for `/`: the Workers asset
 * server rejects `Language=` conditions, and an unconditional `/ → /en/`
 * would override this sniff.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="https://mathzle.com/en/" />
    <title>Mathzle</title>
  </head>
  <body>
    <script>
      // Prefer Vietnamese if any of the browser's languages start with 'vi'.
      const langs = navigator.languages ?? [navigator.language];
      const preferVi = langs.some((l) => l.toLowerCase().startsWith('vi'));
      window.location.replace(preferVi ? '/vi/' : '/en/');
    </script>
    <noscript>
      <p>Redirecting to <a href="/en/">Mathzle</a>.</p>
    </noscript>
  </body>
</html>
