---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ParentSummary from '../../components/ParentSummary.astro';
import { site } from '../../data/site';
import { t } from '../../utils/i18n';

const locale = 'vi' as const;
const path = '/vi/privacy/';
const l = t(locale).legalPages;
---
<Base
  title="Chính sách bảo mật — Mathzle"
  description="Cách Mathzle xử lý dữ liệu. Không quảng cáo, không tracker bên thứ ba trong app trẻ em, không bán dữ liệu."
  locale={locale}
  path={path}
>
  <Nav locale={locale} path={path} />
  <main class="prose-page">
    <header class="prose-hero">
      <h1>Chính sách bảo mật</h1>
      <p class="lead">
        {site.legal.policiesReviewedOn
          ? l.updated.replace('{date}', new Date(site.legal.policiesReviewedOn).toLocaleDateString('vi-VN'))
          : l.pending}
      </p>
    </header>
    <section class="prose">
      <ParentSummary locale={locale} />
      <h2>Chúng mình thu thập gì</h2>
      <ul>
        <li>Email tài khoản (chỉ khi bạn đăng ký)</li>
        <li>Tiến độ bài học để chạy streak và độ khó tự điều chỉnh</li>
        <li>Số liệu phân tích ẩn danh, không cookie, qua Cloudflare Web Analytics</li>
      </ul>
      <h2>Chúng mình không thu thập</h2>
      <ul>
        <li>Không có tracker bên thứ ba trong app trẻ em</li>
        <li>Không chat, không DM, không mạng xã hội</li>
        <li>Không có advertising ID</li>
      </ul>
      <h2>Chúng mình không làm</h2>
      <ul>
        <li>Không bán dữ liệu cho ai</li>
        <li>Không hiển thị quảng cáo trong app trẻ em</li>
        <li>Không chia sẻ dữ liệu với đối tác marketing</li>
      </ul>
      <h2>Trẻ em</h2>
      <p>Mathzle xây cho trẻ 6–11 tuổi. Phụ huynh tạo tài khoản. Nghị định 13 của Việt Nam và các tiêu chuẩn kiểu COPPA được áp dụng — dữ liệu của trẻ chỉ được xử lý để cung cấp trải nghiệm bài học.</p>
      {site.contact.email && (
        <>
          <h2>Liên hệ</h2>
          <p>Câu hỏi về bảo mật: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        </>
      )}
    </section>
  </main>
  <Footer locale={locale} path={path} />
</Base>
