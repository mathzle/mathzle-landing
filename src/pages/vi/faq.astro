---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/sections/FAQ.astro';
import CtaCapture from '../../components/sections/CtaCapture.astro';

const locale = 'vi' as const;
const path = '/vi/faq';
---
<Base
  title="Hỏi đáp — Mathzle"
  description="Câu hỏi thường gặp về Mathzle: giá, độ tuổi, an toàn, hỗ trợ trình duyệt, và lộ trình app iOS/Android."
  locale={locale}
  path={path}
>
  <Nav locale={locale} path={path} />
  <main>
    <FAQ locale={locale} />
    <CtaCapture locale={locale} />
  </main>
  <Footer locale={locale} path={path} />
</Base>
