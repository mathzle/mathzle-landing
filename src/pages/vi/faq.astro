---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/sections/FAQ.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { t } from '../../utils/i18n';
import { pageTitle } from '../../lib/seo';
const locale = 'vi' as const;
const path = '/vi/faq/';
const f = t(locale).faqPage;
---
<Base title={pageTitle(f.title)} description={f.description} locale={locale} path={path}>
  <Nav locale={locale} path={path} />
  <main>
    <FAQ locale={locale} grouped headingLevel="h1" />
    <FinalCta locale={locale} />
  </main>
  <Footer locale={locale} path={path} />
</Base>
