---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { t } from '../../utils/i18n';
import { pageTitle } from '../../lib/seo';

const locale = 'vi' as const;
const path = '/vi/terms/';
const l = t(locale).legalPages;
/*
 * Known claims-register exception: the static legal BODY text below is
 * lawyer-owned and deliberately NOT routed through claims.ts / copy().
 * It restates register facts: ageRange, noDataSale, "free tier free forever".
 * When one of those claims changes, the lawyer updates this text — don't
 * edit it here. The meta description (and ParentSummary) do go through
 * the register like the rest of the site.
 */
---
<Base
  title={pageTitle('Điều khoản sử dụng')}
  description="Các điều khoản khi bạn sử dụng Mathzle. Rõ ràng, công bằng, tôn trọng trẻ em."
  locale={locale}
  path={path}
>
  <Nav locale={locale} path={path} />
  <main class="prose-page">
    <header class="prose-hero">
      <h1>Điều khoản sử dụng</h1>
      <p class="lead">
        {site.legal.policiesReviewedOn
          ? l.updated.replace('{date}', new Date(site.legal.policiesReviewedOn).toLocaleDateString('vi-VN'))
          : l.pending}
      </p>
    </header>
    <section class="prose">
      <h2>Ai có thể dùng Mathzle</h2>
      <p>Mathzle dành cho trẻ 6–11 tuổi. Phụ huynh hoặc người giám hộ phải tạo tài khoản. Chúng mình không quảng cáo trực tiếp đến trẻ em.</p>
      <h2>Bạn có thể làm gì</h2>
      <p>Chơi, học, chia sẻ tiến độ với các thành viên trong gia đình, hủy bất kỳ lúc nào. Bản miễn phí là miễn phí mãi mãi — không có phí bất ngờ.</p>
      <h2>Chúng mình cam kết gì</h2>
      <p>Dịch vụ hoạt động như đã mô tả. Chúng mình thông báo trước khi có thay đổi quan trọng. Chúng mình không bán dữ liệu của bạn.</p>
      <h2>Chúng mình yêu cầu gì</h2>
      <p>Đừng cố phá hoại dịch vụ, cào bài học, hay chia sẻ tài khoản Premium ngoài gia đình bạn.</p>
      {site.contact.email && (
        <>
          <h2>Liên hệ</h2>
          <p>Câu hỏi: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        </>
      )}
    </section>
  </main>
  <Footer locale={locale} path={path} />
</Base>
