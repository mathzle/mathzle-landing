---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Mascot from '../../components/Mascot.astro';
import Story from '../../components/sections/Story.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { copyText } from '../../lib/copy';
import { t } from '../../utils/i18n';
const locale = 'en' as const;
const path = '/en/about';
const a = t(locale).about;
---
<Base title={`${a.title} — Mathzle`} description={copyText(a.description, locale)} locale={locale} path={path}>
  <Nav locale={locale} path={path} />
  <main>
    <Section id="about-hero" tone="canvas" class="about-hero">
      <Mascot state="wave" size={112} />
      <h1 class="mk-display">{a.title}</h1>
      <p class="mk-lead">{a.lead}</p>
    </Section>
    <Story locale={locale} showAboutLink={false} />
    <Section id="principles" tone="tint" labelledby="principles-title">
      <SectionHeader id="principles-title" locale={locale} eyebrow={a.principlesEyebrow} title={a.principlesTitle} />
      <ol class="pr">
        {a.principles.map((p, n) => (
          <li class="mk-card reveal"><span class="pr-n">{String(n + 1).padStart(2, '0')}</span><h3 class="mk-h3">{p.title}</h3><p class="mk-body">{p.body}</p></li>
        ))}
      </ol>
    </Section>
    <FinalCta locale={locale} />
  </main>
  <Footer locale={locale} path={path} />
</Base>
<style>
  :global(.about-hero .mk-container) { display: grid; justify-items: center; text-align: center; gap: 1rem; }
  .pr { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .pr li { padding: 1.75rem; display: grid; gap: 0.5rem; }
  .pr li :global(.mk-body) { margin: 0; }
  .pr-n { font-weight: 800; color: var(--color-primary); }
  @media (max-width: 720px) { .pr { grid-template-columns: 1fr; } }
</style>
