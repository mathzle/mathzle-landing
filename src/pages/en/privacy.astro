---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const locale = 'en' as const;
const path = '/en/privacy';
---
<Base
  title="Privacy Policy — Mathzle"
  description="How Mathzle handles data. No ads, no third-party trackers in the kid app, no data sold."
  locale={locale}
  path={path}
>
  <Nav locale={locale} path={path} />
  <main class="prose-page">
    <header class="prose-hero">
      <h1>Privacy Policy</h1>
      <p class="lead">Last updated: 2026-05-19</p>
    </header>
    <section class="prose">
      <p><strong>TODO(legal):</strong> this is placeholder copy. A lawyer needs to review before launch. The bullet list below is the intent that the policy must encode.</p>

      <h2>What we collect</h2>
      <ul>
        <li>Account email (only if you sign up)</li>
        <li>Lesson progress to power streaks and adaptive difficulty</li>
        <li>Anonymous, cookie-less analytics via Cloudflare Web Analytics</li>
      </ul>

      <h2>What we don't collect</h2>
      <ul>
        <li>No third-party trackers in the kid-facing app</li>
        <li>No chat, no DMs, no social graph</li>
        <li>No advertising IDs</li>
      </ul>

      <h2>What we don't do</h2>
      <ul>
        <li>We don't sell data to anyone</li>
        <li>We don't show ads in the kid-facing app</li>
        <li>We don't share data with marketing partners</li>
      </ul>

      <h2>Children</h2>
      <p>Mathzle is built for kids ages 6–11. Parents create the account. Vietnam's Decree 13 and COPPA-style protections apply — kids' data is processed only to deliver the lesson experience.</p>

      <h2>Contact</h2>
      <p>Privacy questions: <a href="mailto:privacy@mathzle.com">privacy@mathzle.com</a></p>
    </section>
  </main>
  <Footer locale={locale} path={path} />
</Base>

<style is:global>
  .prose-page { max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem 2rem; }
  .prose-hero { margin-bottom: 2rem; }
  .prose-hero h1 { font-family: var(--font-display); font-size: 2.25rem; font-weight: 700; letter-spacing: -0.02em; }
  .prose-hero .lead { color: var(--color-text-tertiary); font-size: 0.9rem; }
  .prose h2 { font-family: var(--font-display); font-size: 1.375rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.5rem; }
  .prose p, .prose li { color: var(--color-text-primary); line-height: 1.65; }
  .prose p { margin-bottom: 1rem; }
  .prose ul { padding-left: 1.25rem; margin-bottom: 1rem; }
  .prose li { margin-bottom: 0.375rem; }
  .prose a { color: var(--color-primary); }
</style>
