---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { t } from '../../utils/i18n';

const locale = 'en' as const;
const path = '/en/terms';
const l = t(locale).legalPages;
---
<Base
  title="Terms of Service — Mathzle"
  description="The terms under which you use Mathzle. Clear, fair, kid-respectful."
  locale={locale}
  path={path}
>
  <Nav locale={locale} path={path} />
  <main class="prose-page">
    <header class="prose-hero">
      <h1>Terms of Service</h1>
      <p class="lead">
        {site.legal.policiesReviewedOn
          ? l.updated.replace('{date}', new Date(site.legal.policiesReviewedOn).toLocaleDateString('en-GB'))
          : l.pending}
      </p>
    </header>
    <section class="prose">
      <h2>Who can use Mathzle</h2>
      <p>Mathzle is built for kids ages 6–11. A parent or guardian must create the account. We don't market to children directly.</p>
      <h2>What you can do</h2>
      <p>Play, learn, share progress with family members, cancel any time. The free tier is free forever — no surprise charges.</p>
      <h2>What we promise</h2>
      <p>The service works as described. We notify you in advance of material changes. We don't sell your data.</p>
      <h2>What we ask</h2>
      <p>Don't try to break the service, scrape lessons, or share premium accounts beyond your family.</p>
      {site.contact.email && (
        <>
          <h2>Contact</h2>
          <p>Questions: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        </>
      )}
    </section>
  </main>
  <Footer locale={locale} path={path} />
</Base>
